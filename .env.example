# FreshRoute Voice-First AI Business Intelligence Agent
# Environment Configuration Template (.env.example)
# Duplicate this file to .env and insert your API keys

# Application Settings
APP_NAME="FreshRoute AI - Voice BI Agent"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Uses SQLite for zero-configuration local runs; seamlessly interchangeable with PostgreSQL
DATABASE_URL="sqlite:///./backend/data/freshroute.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://freshroute_readonly:securepass@localhost:5432/freshroute_db"

SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROW_LIMIT=500

# Gnani.ai API Configuration (Great Indian AI Internship Challenge 2026 - Vachana Platform)
# Enter your Gnani API key starting with vach_...
GNANI_API_KEY=""
GNANI_PRISMA_ENDPOINT="https://api.vachana.ai/stt/v3"
GNANI_TIMBRE_ENDPOINT="https://api.vachana.ai/api/v1/tts/inference"
GNANI_EVON_ENDPOINT=""

GNANI_STT_MODEL="gnani-prisma-v2.5"
GNANI_TTS_MODEL="timbre-v2.5"
GNANI_LLM_MODEL="evon-v3.3"

# Optional Secondary LLM (if testing with OpenAI, otherwise leave blank)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# External Web Search & Weather (100% Free - No Credit Card Needed!)
# Open-Meteo & DuckDuckGo require NO API keys, NO signups, and NO credit cards.
# (Optional Tavily search key if you have one, otherwise leave blank)
TAVILY_API_KEY=""
OPEN_METEO_BASE_URL="https://archive-api.open-meteo.com/v1/archive"

# Agent Guardrails
MAX_INVESTIGATION_STEPS=8
AGENT_TIMEOUT_SECONDS=45
